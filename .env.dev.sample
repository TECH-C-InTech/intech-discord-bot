# ===============================================
# Discord Bot 開発環境用設定
# ===============================================
# このファイルをコピーして .env.dev として使用してください
# cp .env.dev.sample .env.dev

# 開発用Bot Token
# 開発専用のBotアプリケーション
# InTech_dev
DISCORD_BOT_TOKEN="開発用Botのトークン"

# ===============================================
# イベントチャンネル管理用の設定
# ===============================================
EVENT_CATEGORY_NAME="event"  # イベントチャンネルが属するカテゴリー名
ARCHIVE_EVENT_CATEGORY_NAME="archived"  # アーカイブ先のカテゴリー名

# ===============================================
# プロジェクトチャンネル管理用の設定
# ===============================================
PROJECT_CATEGORY_NAME="project"  # プロジェクトチャンネルが属するカテゴリー名
ARCHIVE_PROJECT_CATEGORY_NAME="archived-project"  # アーカイブ先のカテゴリー名

# ===============================================
# クラブチャンネル管理用の設定
# ===============================================
CLUB_CATEGORY_NAME="clubs"

# ===============================================
# 開発環境設定
# ===============================================
# 開発用サーバーのID（必須）
# Discordで開発者モードを有効にして、サーバーを右クリック → 「サーバーIDをコピー」
DEV_GUILD_ID="開発サーバーのID"

# ===============================================
# Keep-aliveサーバー設定
# ===============================================
PORT="8000"
