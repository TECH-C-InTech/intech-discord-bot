# ===============================================
# Discord Bot 環境変数設定
# ===============================================

# Bot Token
# 開発環境と本番環境で別々のBotアプリケーションを使用することを推奨
# - 本番用Bot: InTech
# - 開発用Bot: InTech_dev
DISCORD_BOT_TOKEN="Your discord bot token"

# ===============================================
# イベントチャンネル管理用の設定
# ===============================================
EVENT_CATEGORY_NAME="events"  # イベントチャンネルが属するカテゴリー名
ARCHIVE_EVENT_CATEGORY_NAME="archived-events"  # アーカイブ先のカテゴリー名

# ===============================================
# プロジェクトチャンネル管理用の設定
# ===============================================
PROJECT_CATEGORY_NAME="projects"  # プロジェクトチャンネルが属するカテゴリー名
ARCHIVE_PROJECT_CATEGORY_NAME="archived-projects"  # アーカイブ先のカテゴリー名

# ===============================================
# クラブチャンネル管理用の設定
# ===============================================
CLUB_CATEGORY_NAME="clubs"
ARCHIVE_CLUB_CATEGORY_NAME="archived-clubs"  # アーカイブ先のカテゴリー名


# ===============================================
# Keep-aliveサーバー設定（デプロイ時に使用）
# ===============================================
PORT="8000"  # FastAPIサーバーのポート番号（Render/Railwayなどが自動設定）
